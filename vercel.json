{
  "rewrites": [
    {
      "source": "/audio/:path*",
      "destination": "https://everyayah.com/data/:path*"
    }
  ],
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}